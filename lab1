# Задание 3 Анимация из 3 кадров

def animka():
    f('Анимацияяяя')
    def animation(shift):
        length = 1
        line = '  '
        pixel = esc + '41m  \x1b[0m'
        pad = ' ' * shift
        rows = [
            pad + (line * 4 + pixel + line * 4) * length,
            pad + (line * 3 + pixel + line + pixel + line * 3) * length,
            pad + (line * 2 + pixel + line * 3 + pixel + line * 2) * length,
            pad + (line + pixel + line * 5 + pixel + line) * length,
            pad + (pixel + line * 7 + pixel) * length,
        ]
        return rows

    def main():
        clear()
        height = 1
        positions = list(range(0, 10, 2)) + list(range(5, 0, -2))

        try:
            while True:
                for p in positions:
                    rows = animation(p)
                    for r in rows:
                        sys.stdout.write(r + '\n')
                    sys.stdout.flush()
                    time.sleep(0.5)
                    sys.stdout.write(esc + f'{height}A')  # вверх на 5
                    sys.stdout.flush()
        except KeyboardInterrupt:
            sys.stdout.write(esc + f'{height}B\n')

    if __name__ == '__main__':
        main()

# Задание 4 Числа

def diagr():
    f('Числа больше 5 и меньше 5, отрицательные отбросить')
    width=40
    numbs=[]
    file=open('sequence.txt')
    for line in file:
        if line.strip()!='':
            numbs.append(float(line))
    inside=0 ## <5
    outside=0 ## все остальные без отриц
    for numb in numbs:
        if numb<5 and numb>=0:
            inside+=1
        elif numb>5:
            outside+=1
    total=inside+outside
    percentinside=inside/total*100
    percentoutside=outside/total*100

    leninside=round(percentinside/100*width)
    lenoutside=round(percentoutside/100*width)
    print(f'<-5, <5   {pink}{' '*leninside }{reset} {percentinside:.1f}% ({inside})')
    print(f'остальные {blue}{' '*lenoutside}{reset} {percentoutside:.1f}% ({outside})')

